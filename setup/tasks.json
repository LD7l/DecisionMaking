{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build case_e",
      "type": "shell",
      "command": "g++",
      "args": ["-std=c++17", "-g", "-O2", "-Wall", "-o", "case_e.exe", "src/main.cpp"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run case_e",
      "type": "shell",
      "command": "./case_e.exe",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Build case_e",
      "problemMatcher": []
    }
  ]
}
